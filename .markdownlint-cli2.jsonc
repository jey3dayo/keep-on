{
  "config": {
    "default": true,
    "MD013": false,
    "MD031": true,
    "MD032": true,
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    ".next",
    ".open-next",
    "out",
    "src/generated",
    ".worktrees",
    ".claude/worktrees",
    "apm_modules",
    ".claude/skills",
    ".plans",
    "tmp"
  ],
  "overrides": [
    {
      // Next.js maintains this file's managed block, which contains a second H1.
      "filter": ["AGENTS.md"],
      "config": {
        "MD025": false
      },
      "combine": "merge"
    }
  ]
}
