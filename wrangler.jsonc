{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keep-on",
  "account_id": "4e7695e2370bc9cef6ae9f2802517dd3",
  "main": ".open-next/worker.js",
  // Sentry (@sentry/nextjs) requires https.request, available from 2025-08-16 onward
  "compatibility_date": "2025-08-16",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  // 本番は custom domain のみで配信し、workers.dev URL を Cloudflare Access の裏口にしない
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "keep-on.jey3dayo.net", "custom_domain": true }],
  "vars": {
    "NEXTJS_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "jey3dayo.cloudflareaccess.com",
    "ACCESS_AUD": "54d9edf4cf8bb45623178233925ec2309166a6f2d785e3abac28bc7587473c16"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "feaaf2df1aab41b68e7a19cb48779738"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keep-on-db",
      "database_id": "763c22af-de35-49ef-8171-2ae5293491d5",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "preview": {
      // トップレベルで workers_dev を false にしたため、PR プレビューの唯一の入口である workers.dev URL を維持するには明示上書きが必要
      "workers_dev": true,
      // top-level の routes(本番 custom domain)を継承すると preview デプロイ時に custom domain が付け替わるため空配列で遮断
      "routes": [],
      // preview は workers.dev 直アクセスで Cloudflare Access を経由しないため、
      // ACCESS_AUD を本番と同値にしても JWT 検証は失敗し identity は null になるだけ。
      // preview 環境の認証運用は別途検討する。
      "vars": {
        "NEXTJS_ENV": "preview",
        "ACCESS_TEAM_DOMAIN": "jey3dayo.cloudflareaccess.com",
        "ACCESS_AUD": "54d9edf4cf8bb45623178233925ec2309166a6f2d785e3abac28bc7587473c16"
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "feaaf2df1aab41b68e7a19cb48779738"
        }
      ],
      // 本番 D1 を preview と共有しない(スキーマ乖離事故防止)。
      // preview 専用 DB(keep-on-db-preview)へ分離し、本番データへの誤アクセス・
      // 未検証マイグレーションによる本番スキーマ破壊のリスクを排除する。
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "keep-on-db-preview",
          "database_id": "d255dc42-ec49-4e6e-b79e-b4462cbd68f0",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
