{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keep-on",
  "account_id": "4e7695e2370bc9cef6ae9f2802517dd3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  // 本番は custom domain のみで配信し、workers.dev URL を Cloudflare Access の裏口にしない
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "keep-on.jey3dayo.net", "custom_domain": true }],
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuamV5M2RheW8ubmV0JA",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_FRONTEND_API": "clerk.jey3dayo.net"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "feaaf2df1aab41b68e7a19cb48779738"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keep-on-db",
      "database_id": "763c22af-de35-49ef-8171-2ae5293491d5"
    }
  ],
  "env": {
    "preview": {
      // トップレベルで workers_dev を false にしたため、PR プレビューの唯一の入口である workers.dev URL を維持するには明示上書きが必要
      "workers_dev": true,
      // top-level の routes(本番 custom domain)を継承すると preview デプロイ時に custom domain が付け替わるため空配列で遮断
      "routes": [],
      "vars": {
        "NEXTJS_ENV": "preview",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuamV5M2RheW8ubmV0JA",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
        "NEXT_PUBLIC_CLERK_FRONTEND_API": "clerk.jey3dayo.net"
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "feaaf2df1aab41b68e7a19cb48779738"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "keep-on-db",
          "database_id": "763c22af-de35-49ef-8171-2ae5293491d5"
        }
      ]
    }
  }
}
