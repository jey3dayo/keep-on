{
  "name": "keep-on",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent:browser": "tsx scripts/agent-browser-playwright.ts",
    "build": "if [ -n \"$CF_BUILD\" ]; then dotenvx run --overload -- next build; else dotenvx run --overload -f .env -f .env.development -- next build; fi",
    "build:cf": "CF_BUILD=1 dotenvx run --overload -- opennextjs-cloudflare build && node scripts/stamp-sw-version.mjs",
    "cf:alerts": "./scripts/setup-cloudflare-alerts.sh",
    "cf:deploy": "dotenvx run --overload -- wrangler deploy",
    "cf:logs": "dotenvx run -- wrangler tail --format pretty",
    "cf:metrics": "./scripts/get-workers-metrics.sh",
    "cf:preview": "dotenvx run -- opennextjs-cloudflare preview",
    "cf:secret": "dotenvx run -- wrangler secret",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "dotenvx run -- wrangler d1 migrations apply keep-on-db --local",
    "db:migrate:preview": "dotenvx run -- wrangler d1 migrations apply keep-on-db-preview --remote --env preview",
    "db:migrate:remote": "dotenvx run -- wrangler d1 migrations apply keep-on-db --remote",
    "db:studio": "dotenvx run --overload -f .env -f .env.development -- drizzle-kit studio --dialect=sqlite",
    "deploy": "run-s build:cf cf:deploy",
    "predev": "CI=1 pnpm run db:migrate:local",
    "dev": "dotenvx run --overload -f .env -f .env.development -- next dev --turbopack",
    "doctor": "ultracite doctor",
    "doctor:react": "react-doctor .",
    "env:decrypt": "dotenvx decrypt && dotenvx decrypt -f .env.development",
    "env:encrypt": "dotenvx encrypt && dotenvx encrypt -f .env.development",
    "env:run": "dotenvx run --overload -f .env -f .env.development --",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "start": "dotenvx run --overload -f .env -f .env.development -- next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "dotenvx run --overload -f .env -f .env.development -- vitest",
    "test:coverage": "dotenvx run --overload -f .env -f .env.development -- vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project tsconfig.e2e.json --noEmit",
    "test:e2e:ui": "playwright test --ui",
    "test:run": "dotenvx run --overload -f .env -f .env.development -- vitest run",
    "test:storybook": "dotenvx run --overload -f .env -f .env.development -- vitest --config vitest.storybook.config.ts",
    "test:storybook:browser": "node scripts/storybook-smoke.mjs",
    "test:storybook:run": "dotenvx run --overload -f .env -f .env.development -- vitest run --config vitest.storybook.config.ts",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "test:ui": "dotenvx run --overload -f .env -f .env.development -- vitest --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@paralleldrive/cuid2": "^3.3.0",
    "@praha/byethrow": "^0.13.0",
    "@praha/error-factory": "^1.4.1",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "11.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.5.11",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@dotenvx/dotenvx": "^2.38.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "agentation": "^3.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "npm-run-all2": "^9.0.4",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.13.0",
    "pnpm": "12.16.1"
  }
}
