{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // public/ はブラウザ直配信のランタイム資産（sw.js 含む）、*.svg は画像アセット
    "includes": ["**/*", "!!**/src/components/ui", "!public", "!**/*.svg"]
  },
  "formatter": {
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off",
        // ultracite 7.9 で追加されたスタイル系。既存コードの記法（非分割代入・i++）と衝突するため無効化
        "useDestructuring": "off",
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        // 防御的チェック（D1/リトライ境界の実行時ガード）を誤検知するため無効化
        "noUnnecessaryConditions": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off",
        // D1 は 1 クエリ = 1 往復のため、直列 await ループが意図的な箇所が多く無効化
        "noAwaitInLoops": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "overrides": [
    {
      // valibot スキーマはオブジェクトのキー定義順がそのまま検証・issue 収集順になるため、
      // キーソートを適用すると最初に報告されるバリデーションエラーのフィールドが変わる
      "includes": ["src/schemas/**"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    {
      // WAI-ARIA APG の grid パターンでは、role="grid"/"row"/"columnheader"/"gridcell" は
      // 構造上のロールでありフォーカス先ではない。セルが単一のウィジェット（roving tabindex を
      // 持つ button）を含む場合、フォーカスはそのウィジェットへ委譲され、複合ウィジェット全体で
      // ページの Tab 順序に含まれるフォーカス可能要素は1つだけになる。useFocusableInteractive は
      // この「フォーカスが子要素へ委譲される」パターンを認識せず、構造用の role にも tabIndex を
      // 要求してしまうため誤検知になる。
      //
      // このルールにはロール単位（row/columnheader/gridcell だけ）で絞り込むオプションが無い
      // （`UseFocusableInteractiveOptions` はスキーマ上 additionalProperties:false の空
      // オブジェクト）。そのため、この構造マークアップだけを持つ
      // `HabitCalendarGridStructure.tsx` へ切り出し、override 対象をそのファイルだけに限定した。
      // ロジック（roving tabindex の state・キーハンドラ・セルの描画）を持つ
      // `HabitCalendarHeatmap.tsx` 側は本ルールが有効なままなので、今後 role="button" 等を
      // 誤って追加してもここで検出される。
      "includes": ["src/components/habits/HabitCalendarGridStructure.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
